# ---- required ----
DOMAIN=intel.example.com
POSTGRES_PASSWORD=change-me-long-random
JWT_SECRET=change-me-64-random-chars          # openssl rand -hex 32
SEC_USER_AGENT=YourCompany Intel ops@yourdomain.com   # SEC + Wikimedia require a real contact
CORS_ORIGINS=https://intel.example.com

# ---- LLM (optional; without keys the app runs in deterministic rules mode) ----
ANTHROPIC_API_KEY=
LLM_CHEAP=anthropic:claude-haiku-4-5          # extraction / classification / follow-ups
LLM_STRONG=anthropic:claude-opus-5-5          # report synthesis (anthropic:claude-sonnet-5-5 is the cheaper option)
OPENAI_API_KEY=                               # also enables server-side STT/TTS (whisper-1 / tts-1)
GOOGLE_API_KEY=

# ---- data providers (optional) ----
BRAVE_SEARCH_API_KEY=                         # licensed web search: IR pages, industry media, LinkedIn snippets
COMPANIES_HOUSE_API_KEY=                      # UK filings (free)
OPENFIGI_API_KEY=                             # higher OpenFIGI rate limits (free)
ENABLE_GOOGLE_NEWS_RSS=false                  # personal/non-commercial terms: keep false for a public service

# ---- behaviour ----
REPORT_TTL_MINUTES=30
ANON_ANALYSES_PER_DAY=10
USER_ANALYSES_PER_DAY=50
RATE_LIMIT_PER_MINUTE=30
DAILY_REFRESH_HOUR_UTC=1
